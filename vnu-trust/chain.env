# NGUỒN DUY NHẤT của thông số chuỗi cho cả hệ thống.
#
# Sửa ở đây rồi chạy `./scripts/sync-chain-env.sh` — script sẽ ghi các giá trị
# này sang backend/.env, backend-go/.env và frontend/.env (dưới dạng VITE_*).
# Trước đây địa chỉ hợp đồng nằm rải rác ở ba tệp .env, đổi sót một chỗ là hai
# backend nói chuyện với hai gói khác nhau mà không ai báo lỗi.
#
# `scripts/deploy.sh` tự cập nhật CONTRACT_ADDRESS ở đây sau khi publish.

CONTRACT_ADDRESS=0x0ede7f6b38caab7ddfe757765fddbf07221f8b776c6395562faae571250708e3
CHAIN_FULLNODE=https://testnet.movementnetwork.xyz/v1
CHAIN_ID=250
CHAIN_FAUCET=https://faucet.testnet.movementnetwork.xyz
CHAIN_EXPLORER=https://explorer.movementnetwork.xyz/txn
