# Chép thành deploy/.env (đã nằm trong .gitignore) rồi điền.
# Chỉ dùng cho hai tập lệnh chạy TỪ MÁY BẠN: init-db.sh và check.sh.
# Biến của dịch vụ trên host nhập ở bảng điều khiển Render/Vercel, không lấy từ đây.

# --- Postgres trên Neon/Supabase (lấy trong trang Connection details) ---
# Neon: dùng host KHÔNG có "-pooler" (kết nối trực tiếp).
DB_HOST=ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=
DB_SSLMODE=require

# --- URL sau khi triển khai (cho check.sh) ---
WEB_URL=https://vnu-trust-web.onrender.com
TS_URL=https://vnu-trust-ts.onrender.com
GO_URL=https://vnu-trust-go.onrender.com
